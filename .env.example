# Application
NODE_ENV=development

# Host ports (change only if a local conflict exists)
FRONTEND_PORT=5173
BACKEND_PORT=3000
POSTGRES_PORT=5432
ADMINER_PORT=8080

# PostgreSQL credentials (development placeholders — change for shared environments)
POSTGRES_USER=playground
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=ai_playground

# Browser-facing frontend origin used by backend CORS
FRONTEND_URL=http://localhost:5173

# Browser-facing API base URL used by the Vite frontend
# Must be reachable from the host browser — never use the Docker service hostname here
VITE_API_BASE_URL=http://localhost:3000/api

# AI provider selection (backend only — never expose keys to the frontend)
# Supported: openai | anthropic
# Tool calling (Task Assistant) currently requires openai.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Embeddings for Semantic Document Search (must match VECTOR(1536) migration)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Semantic Document Search
SEMANTIC_SEARCH_MAX_FILE_SIZE_MB=10
SEMANTIC_SEARCH_CHUNK_SIZE=800
SEMANTIC_SEARCH_CHUNK_OVERLAP=120

# PDF RAG (Project 4)
RAG_MODEL=
RAG_DEFAULT_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.22
RAG_MAX_CONTEXT_CHARS=12000

# AI Research Assistant (Project 5) — Tavily web search (backend only)
# Get a key at https://tavily.com — feature returns 503 if unset
TAVILY_API_KEY=
RESEARCH_MAX_RESULTS=6
RESEARCH_MAX_FOLLOWUP_QUERIES=2
RESEARCH_FETCH_TIMEOUT_MS=8000
RESEARCH_MAX_PAGE_BYTES=500000
RESEARCH_MODEL=

# HMAC secret for task delete confirmation tokens (backend only)
TASK_DELETE_SECRET=change_me_locally_task_delete

# Optional for running the API outside Docker Compose
# PORT=3000
# DATABASE_URL=postgresql://playground:change_me_locally@localhost:5432/ai_playground
